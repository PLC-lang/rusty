// RUN: %COMPILE %s && %RUN | %CHECK %s
//
// REAL and LREAL to the bit string types round half away from zero, then keep the low bits of the
// target width, so an out-of-range value wraps and a negative value lands at the top of the range.
// A value outside the signed 64-bit range, NaN and the infinities included, becomes 2^63 first; the
// smaller targets therefore see 0. The rows measured on CODESYS 3.5 SP22 are the anchors; the DWORD
// and LWORD cells for NaN and the infinities follow from the same model and were not measured.

FUNCTION main
VAR
    ninf  : REAL;
    lninf : LREAL;
END_VAR
ninf  := -INF_REAL;
lninf := -INF_LREAL;

// ---- REAL source: BYTE WORD DWORD LWORD
// rounding, ties away from zero
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#0.4),  REAL_TO_WORD(REAL#0.4),  REAL_TO_DWORD(REAL#0.4),  REAL_TO_LWORD(REAL#0.4));   // CHECK: 0 0 0 0
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#0.5),  REAL_TO_WORD(REAL#0.5),  REAL_TO_DWORD(REAL#0.5),  REAL_TO_LWORD(REAL#0.5));   // CHECK: 1 1 1 1
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#0.6),  REAL_TO_WORD(REAL#0.6),  REAL_TO_DWORD(REAL#0.6),  REAL_TO_LWORD(REAL#0.6));   // CHECK: 1 1 1 1
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#1.5),  REAL_TO_WORD(REAL#1.5),  REAL_TO_DWORD(REAL#1.5),  REAL_TO_LWORD(REAL#1.5));   // CHECK: 2 2 2 2
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#2.5),  REAL_TO_WORD(REAL#2.5),  REAL_TO_DWORD(REAL#2.5),  REAL_TO_LWORD(REAL#2.5));   // CHECK: 3 3 3 3
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#3.5),  REAL_TO_WORD(REAL#3.5),  REAL_TO_DWORD(REAL#3.5),  REAL_TO_LWORD(REAL#3.5));   // CHECK: 4 4 4 4
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#-0.5), REAL_TO_WORD(REAL#-0.5), REAL_TO_DWORD(REAL#-0.5), REAL_TO_LWORD(REAL#-0.5));  // CHECK: 255 65535 4294967295 18446744073709551615
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#-1.5), REAL_TO_WORD(REAL#-1.5), REAL_TO_DWORD(REAL#-1.5), REAL_TO_LWORD(REAL#-1.5));  // CHECK: 254 65534 4294967294 18446744073709551614
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#-2.5), REAL_TO_WORD(REAL#-2.5), REAL_TO_DWORD(REAL#-2.5), REAL_TO_LWORD(REAL#-2.5));  // CHECK: 253 65533 4294967293 18446744073709551613
// range, wraps modulo the target width
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#255.5),   REAL_TO_WORD(REAL#255.5),   REAL_TO_DWORD(REAL#255.5),   REAL_TO_LWORD(REAL#255.5));    // CHECK: 0 256 256 256
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#256.0),   REAL_TO_WORD(REAL#256.0),   REAL_TO_DWORD(REAL#256.0),   REAL_TO_LWORD(REAL#256.0));    // CHECK: 0 256 256 256
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#300.0),   REAL_TO_WORD(REAL#300.0),   REAL_TO_DWORD(REAL#300.0),   REAL_TO_LWORD(REAL#300.0));    // CHECK: 44 300 300 300
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#-1.0),    REAL_TO_WORD(REAL#-1.0),    REAL_TO_DWORD(REAL#-1.0),    REAL_TO_LWORD(REAL#-1.0));     // CHECK: 255 65535 4294967295 18446744073709551615
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#65536.0), REAL_TO_WORD(REAL#65536.0), REAL_TO_DWORD(REAL#65536.0), REAL_TO_LWORD(REAL#65536.0));  // CHECK: 0 0 65536 65536
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#1.0E10),  REAL_TO_WORD(REAL#1.0E10),  REAL_TO_DWORD(REAL#1.0E10),  REAL_TO_LWORD(REAL#1.0E10));   // CHECK: 0 58368 1410065408 10000000000
printf('%d %d %u %llu$N', REAL_TO_BYTE(REAL#1.0E20),  REAL_TO_WORD(REAL#1.0E20),  REAL_TO_DWORD(REAL#1.0E20),  REAL_TO_LWORD(REAL#1.0E20));   // CHECK: 0 0 0 9223372036854775808
// not a number
printf('%d %d %u %llu$N', REAL_TO_BYTE(INF_REAL), REAL_TO_WORD(INF_REAL), REAL_TO_DWORD(INF_REAL), REAL_TO_LWORD(INF_REAL));  // CHECK: 0 0 0 9223372036854775808
printf('%d %d %u %llu$N', REAL_TO_BYTE(ninf),     REAL_TO_WORD(ninf),     REAL_TO_DWORD(ninf),     REAL_TO_LWORD(ninf));      // CHECK: 0 0 0 9223372036854775808
printf('%d %d %u %llu$N', REAL_TO_BYTE(NAN_REAL), REAL_TO_WORD(NAN_REAL), REAL_TO_DWORD(NAN_REAL), REAL_TO_LWORD(NAN_REAL));  // CHECK: 0 0 0 9223372036854775808

// ---- LREAL source: BYTE WORD DWORD LWORD
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#0.5),     LREAL_TO_WORD(LREAL#0.5),     LREAL_TO_DWORD(LREAL#0.5),     LREAL_TO_LWORD(LREAL#0.5));      // CHECK: 1 1 1 1
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#2.5),     LREAL_TO_WORD(LREAL#2.5),     LREAL_TO_DWORD(LREAL#2.5),     LREAL_TO_LWORD(LREAL#2.5));      // CHECK: 3 3 3 3
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#-0.5),    LREAL_TO_WORD(LREAL#-0.5),    LREAL_TO_DWORD(LREAL#-0.5),    LREAL_TO_LWORD(LREAL#-0.5));     // CHECK: 255 65535 4294967295 18446744073709551615
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#-2.5),    LREAL_TO_WORD(LREAL#-2.5),    LREAL_TO_DWORD(LREAL#-2.5),    LREAL_TO_LWORD(LREAL#-2.5));     // CHECK: 253 65533 4294967293 18446744073709551613
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#255.5),   LREAL_TO_WORD(LREAL#255.5),   LREAL_TO_DWORD(LREAL#255.5),   LREAL_TO_LWORD(LREAL#255.5));    // CHECK: 0 256 256 256
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#300.0),   LREAL_TO_WORD(LREAL#300.0),   LREAL_TO_DWORD(LREAL#300.0),   LREAL_TO_LWORD(LREAL#300.0));    // CHECK: 44 300 300 300
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#-1.0),    LREAL_TO_WORD(LREAL#-1.0),    LREAL_TO_DWORD(LREAL#-1.0),    LREAL_TO_LWORD(LREAL#-1.0));     // CHECK: 255 65535 4294967295 18446744073709551615
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#65536.0), LREAL_TO_WORD(LREAL#65536.0), LREAL_TO_DWORD(LREAL#65536.0), LREAL_TO_LWORD(LREAL#65536.0));  // CHECK: 0 0 65536 65536
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#1.0E10),  LREAL_TO_WORD(LREAL#1.0E10),  LREAL_TO_DWORD(LREAL#1.0E10),  LREAL_TO_LWORD(LREAL#1.0E10));   // CHECK: 0 58368 1410065408 10000000000
printf('%d %d %u %llu$N', LREAL_TO_BYTE(LREAL#1.0E20),  LREAL_TO_WORD(LREAL#1.0E20),  LREAL_TO_DWORD(LREAL#1.0E20),  LREAL_TO_LWORD(LREAL#1.0E20));   // CHECK: 0 0 0 9223372036854775808
printf('%d %d %u %llu$N', LREAL_TO_BYTE(INF_LREAL), LREAL_TO_WORD(INF_LREAL), LREAL_TO_DWORD(INF_LREAL), LREAL_TO_LWORD(INF_LREAL));  // CHECK: 0 0 0 9223372036854775808
printf('%d %d %u %llu$N', LREAL_TO_BYTE(lninf),     LREAL_TO_WORD(lninf),     LREAL_TO_DWORD(lninf),     LREAL_TO_LWORD(lninf));      // CHECK: 0 0 0 9223372036854775808
printf('%d %d %u %llu$N', LREAL_TO_BYTE(NAN_LREAL), LREAL_TO_WORD(NAN_LREAL), LREAL_TO_DWORD(NAN_LREAL), LREAL_TO_LWORD(NAN_LREAL));  // CHECK: 0 0 0 9223372036854775808

// ---- the generic form calls the named one
printf('%d %d %u %llu$N', TO_BYTE(REAL#300.0), TO_WORD(LREAL#-1.0), TO_DWORD(REAL#1.0E10), TO_LWORD(LREAL#-0.5));  // CHECK: 44 65535 1410065408 18446744073709551615
END_FUNCTION
