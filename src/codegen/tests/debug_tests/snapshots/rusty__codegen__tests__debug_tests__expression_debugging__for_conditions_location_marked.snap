---
source: src/codegen/tests/debug_tests/expression_debugging.rs
expression: result
---
; ModuleID = '<internal>'
source_filename = "<internal>"
target datalayout = "[filtered]"
target triple = "[filtered]"

define i32 @myFunc() !dbg !4 {
entry:
  %myFunc = alloca i32, align [filtered]
    #dbg_declare(ptr %myFunc, !8, !DIExpression(), !10)
  store i32 0, ptr %myFunc, align [filtered]
  %__ran_once_0 = alloca i8, align [filtered]
  store i8 0, ptr %__ran_once_0, align [filtered], !dbg !11
  %__is_incrementing_0 = alloca i8, align [filtered]
  store i8 0, ptr %__is_incrementing_0, align [filtered], !dbg !12
  store i32 1, ptr %myFunc, align [filtered], !dbg !13
  store i8 1, ptr %__is_incrementing_0, align [filtered], !dbg !14
  br label %while_body, !dbg !15

while_body:                                       ; preds = %continue2, %entry
  %load___ran_once_0 = load i8, ptr %__ran_once_0, align [filtered], !dbg !11
  %0 = icmp ne i8 %load___ran_once_0, 0, !dbg !11
  br i1 %0, label %condition_body, label %continue1, !dbg !16

continue:                                         ; preds = %condition_body11, %condition_body7
  %myFunc_ret = load i32, ptr %myFunc, align [filtered], !dbg !17
  ret i32 %myFunc_ret, !dbg !18

condition_body:                                   ; preds = %while_body
  %load_myFunc = load i32, ptr %myFunc, align [filtered], !dbg !19
  %tmpVar = add i32 %load_myFunc, 2, !dbg !19
  store i32 %tmpVar, ptr %myFunc, align [filtered], !dbg !20
  br label %continue1, !dbg !21

continue1:                                        ; preds = %condition_body, %while_body
  store i8 1, ptr %__ran_once_0, align [filtered], !dbg !11
  %load___is_incrementing_0 = load i8, ptr %__is_incrementing_0, align [filtered], !dbg !11
  %1 = icmp ne i8 %load___is_incrementing_0, 0, !dbg !11
  br i1 %1, label %condition_body3, label %else, !dbg !22

condition_body3:                                  ; preds = %continue1
  %load_myFunc5 = load i32, ptr %myFunc, align [filtered], !dbg !19
  %tmpVar6 = icmp sgt i32 %load_myFunc5, 20, !dbg !19
  %2 = zext i1 %tmpVar6 to i8, !dbg !19
  %3 = icmp ne i8 %2, 0, !dbg !19
  br i1 %3, label %condition_body7, label %continue4, !dbg !23

else:                                             ; preds = %continue1
  %load_myFunc9 = load i32, ptr %myFunc, align [filtered], !dbg !19
  %tmpVar10 = icmp slt i32 %load_myFunc9, 20, !dbg !19
  %4 = zext i1 %tmpVar10 to i8, !dbg !19
  %5 = icmp ne i8 %4, 0, !dbg !19
  br i1 %5, label %condition_body11, label %continue8, !dbg !24

continue2:                                        ; preds = %continue8, %continue4
  store i32 1, ptr %myFunc, align [filtered], !dbg !25
  br label %while_body, !dbg !26

condition_body7:                                  ; preds = %condition_body3
  br label %continue, !dbg !27

buffer_block:                                     ; No predecessors!
  br label %continue4, !dbg !28

continue4:                                        ; preds = %buffer_block, %condition_body3
  br label %continue2, !dbg !29

condition_body11:                                 ; preds = %else
  br label %continue, !dbg !30

buffer_block12:                                   ; No predecessors!
  br label %continue8, !dbg !31

continue8:                                        ; preds = %buffer_block12, %else
  br label %continue2, !dbg !32
}

!llvm.module.flags = !{!0, !1}
!llvm.dbg.cu = !{!2}

!0 = !{i32 2, !"Dwarf Version", i32 5}
!1 = !{i32 2, !"Debug Info Version", i32 3}
!2 = distinct !DICompileUnit(language: DW_LANG_C, file: !3, producer: "RuSTy Structured text Compiler", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false)
!3 = !DIFile(filename: "<internal>", directory: "")
!4 = distinct !DISubprogram(name: "myFunc", linkageName: "myFunc", scope: !3, file: !3, line: 2, type: !5, scopeLine: 3, flags: DIFlagPublic, spFlags: DISPFlagDefinition, unit: !2, retainedNodes: !7, keyInstructions: true)
!5 = !DISubroutineType(flags: DIFlagPublic, types: !6)
!6 = !{null}
!7 = !{}
!8 = !DILocalVariable(name: "myFunc", scope: !4, file: !3, line: 2, type: !9, align [filtered])
!9 = !DIBasicType(name: "DINT", size: 32, encoding: DW_ATE_signed, flags: DIFlagPublic)
!10 = !DILocation(line: 2, column: 17, scope: !4)
!11 = !DILocation(line: 0, scope: !4)
