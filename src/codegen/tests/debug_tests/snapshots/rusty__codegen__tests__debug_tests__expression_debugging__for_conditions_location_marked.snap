---
source: src/codegen/tests/debug_tests/expression_debugging.rs
expression: result
---
; ModuleID = '<internal>'
source_filename = "<internal>"
target datalayout = "[filtered]"
target triple = "[filtered]"

define i32 @myFunc() !dbg !4 {
entry:
  %myFunc = alloca i32, align [filtered]
    #dbg_declare(ptr %myFunc, !8, !DIExpression(), !10)
  store i32 0, ptr %myFunc, align [filtered]
  %__ran_once_0 = alloca i8, align [filtered]
  store i8 0, ptr %__ran_once_0, align [filtered], !dbg !11
  %__is_incrementing_0 = alloca i8, align [filtered]
  store i8 0, ptr %__is_incrementing_0, align [filtered], !dbg !11
  %__next_0 = alloca i64, align [filtered]
  store i64 0, ptr %__next_0, align [filtered], !dbg !12
  store volatile i32 1, ptr %myFunc, align [filtered], !dbg !13
  store i8 1, ptr %__is_incrementing_0, align [filtered], !dbg !14
  br label %while_body, !dbg !15

while_body:                                       ; preds = %continue3, %entry
  %load_myFunc = load i32, ptr %myFunc, align [filtered], !dbg !11
  %0 = sext i32 %load_myFunc to i64, !dbg !11
  store i64 %0, ptr %__next_0, align [filtered], !dbg !11
  %load___ran_once_0 = load i8, ptr %__ran_once_0, align [filtered], !dbg !11
  %1 = icmp ne i8 %load___ran_once_0, 0, !dbg !11
  br i1 %1, label %condition_body, label %continue1, !dbg !16

continue:                                         ; preds = %condition_body12, %condition_body8
  %myFunc_ret = load i32, ptr %myFunc, align [filtered], !dbg !17
  ret i32 %myFunc_ret, !dbg !18

condition_body:                                   ; preds = %while_body
  %load___next_0 = load i64, ptr %__next_0, align [filtered], !dbg !11
  %tmpVar = add i64 %load___next_0, 2, !dbg !11
  store i64 %tmpVar, ptr %__next_0, align [filtered], !dbg !19
  %load___next_02 = load i64, ptr %__next_0, align [filtered], !dbg !20
  %2 = trunc i64 %load___next_02 to i32, !dbg !20
  store volatile i32 %2, ptr %myFunc, align [filtered], !dbg !21
  br label %continue1, !dbg !22

continue1:                                        ; preds = %condition_body, %while_body
  store i8 1, ptr %__ran_once_0, align [filtered], !dbg !11
  %load___is_incrementing_0 = load i8, ptr %__is_incrementing_0, align [filtered], !dbg !11
  %3 = icmp ne i8 %load___is_incrementing_0, 0, !dbg !11
  br i1 %3, label %condition_body4, label %else, !dbg !23

condition_body4:                                  ; preds = %continue1
  %load___next_06 = load i64, ptr %__next_0, align [filtered], !dbg !20
  %tmpVar7 = icmp sgt i64 %load___next_06, 20, !dbg !20
  %4 = zext i1 %tmpVar7 to i8, !dbg !20
  %5 = icmp ne i8 %4, 0, !dbg !20
  br i1 %5, label %condition_body8, label %continue5, !dbg !24

else:                                             ; preds = %continue1
  %load___next_010 = load i64, ptr %__next_0, align [filtered], !dbg !20
  %tmpVar11 = icmp slt i64 %load___next_010, 20, !dbg !20
  %6 = zext i1 %tmpVar11 to i8, !dbg !20
  %7 = icmp ne i8 %6, 0, !dbg !20
  br i1 %7, label %condition_body12, label %continue9, !dbg !25

continue3:                                        ; preds = %continue9, %continue5
  store volatile i32 1, ptr %myFunc, align [filtered], !dbg !26
  br label %while_body, !dbg !27

condition_body8:                                  ; preds = %condition_body4
  br label %continue, !dbg !28

buffer_block:                                     ; No predecessors!
  br label %continue5, !dbg !29

continue5:                                        ; preds = %buffer_block, %condition_body4
  br label %continue3, !dbg !30

condition_body12:                                 ; preds = %else
  br label %continue, !dbg !31

buffer_block13:                                   ; No predecessors!
  br label %continue9, !dbg !32

continue9:                                        ; preds = %buffer_block13, %else
  br label %continue3, !dbg !33
}

!llvm.module.flags = !{!0, !1}
!llvm.dbg.cu = !{!2}

!0 = !{i32 2, !"Dwarf Version", i32 5}
!1 = !{i32 2, !"Debug Info Version", i32 3}
!2 = distinct !DICompileUnit(language: DW_LANG_C, file: !3, producer: "RuSTy Structured text Compiler", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug, splitDebugInlining: false)
!3 = !DIFile(filename: "<internal>", directory: "")
!4 = distinct !DISubprogram(name: "myFunc", linkageName: "myFunc", scope: !3, file: !3, line: 2, type: !5, scopeLine: 3, flags: DIFlagPublic, spFlags: DISPFlagDefinition, unit: !2, retainedNodes: !7, keyInstructions: true)
!5 = !DISubroutineType(flags: DIFlagPublic, types: !6)
!6 = !{null}
!7 = !{}
