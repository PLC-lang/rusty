{
    "name": "RuSTy",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "ubuntu",
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "vadimcn.vscode-lldb",
                "mutantdino.resourcemonitor"
            ],
            "settings": {
                "lldb.executable": "/usr/bin/lldb",
                "files.watcherExclude": {
                    "**/target/**": true
                }
            }
        }
    },
    // Only the workspace is writable from the host. The container definition is mounted read-only,
    // the home directory and the build cache live on named volumes.
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
        "source=rusty-home-${devcontainerId},target=/home/ubuntu,type=volume",
        "source=rusty-target-${devcontainerId},target=/workspace/target,type=volume"
    ],
    "privileged": false,
    // Unprivileged container with a read-only root filesystem. No resource limits, builds get the whole host.
    // /tmp allows exec because the stdlib tests load shared objects from there.
    "runArgs": [
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges:true",
        "--init",
        "--read-only",
        "--tmpfs=/tmp:rw,nosuid,nodev,exec",
        "--env-file=${localWorkspaceFolder}/.devcontainer/sandbox.env"
    ],
    "shutdownAction": "stopContainer"
}
